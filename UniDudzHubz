local function mkToggleBtn(parent, textOff, textOn, xp, yp, w, h, callback)
	local state = false
	local b = mkBtn(parent, textOff, xp, yp, w, h)

	b.Activated:Connect(function()
		state = not state
		b:SetAttribute("Active", state)
		if state then
			b.Text = textOn
			tw(b, 0.15, { BackgroundColor3 = COLOR_BUTTON_ACTIVE })
		else
			b.Text = textOff
			tw(b, 0.15, { BackgroundColor3 = COLOR_BUTTON })
		end
		if callback then callback(state) end
	end)

	return b, function() return state end
end

