local function shakeFrame(f)
	local orig = f.Position
	for _, ox in ipairs({ -8, 8, -6, 6, -4, 4, -2, 2, 0 }) do
		tw(f, 0.04, {
			Position = UDim2.new(orig.X.Scale, orig.X.Offset + ox, orig.Y.Scale, orig.Y.Offset)
		}, Enum.EasingStyle.Linear)
		task.wait(0.045)
	end
end

