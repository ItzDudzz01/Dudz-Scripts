local espOn = false
local espObjects = {}

local btnESP =
	mkBtn(visTab, "Player ESP", 16, 128, 170, 34)

local function clearESP()
	for _, v in pairs(espObjects) do
		if v then
			v:Destroy()
		end
	end
	table.clear(espObjects)
end

local function createESP(plr)
	if plr == player then return end
	if not plr.Character then return end

	local hl = Instance.new("Highlight")
	hl.Name = "DudzESP"
	hl.FillTransparency = 0.82
	hl.OutlineTransparency = 0
	hl.FillColor = Color3.fromRGB(255,255,255)
	hl.OutlineColor = COLOR_ACCENT
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Adornee = plr.Character
	hl.Parent = screenGui

	espObjects[plr] = hl
end

local function refreshESP()
	clearESP()

	if not espOn then
		return
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		createESP(plr)
	end
end

btnESP.Activated:Connect(function()
	espOn = not espOn

	btnESP:SetAttribute("Active", espOn)

	if espOn then
		btnESP.Text = "Player ESP [ON]"

		tw(btnESP, 0.15, {
			BackgroundColor3 = COLOR_BUTTON_ACTIVE
		})

		refreshESP()

		toast("ESP Enabled", COLOR_ACCENT)

	else
		btnESP.Text = "Player ESP"

		tw(btnESP, 0.15, {
			BackgroundColor3 = COLOR_BUTTON
		})

		clearESP()

		toast("ESP Disabled", COLOR_SUB)
	end
end)

Players.PlayerAdded:Connect(function(plr)
	plr.CharacterAdded:Connect(function()
		task.wait(1)

		if espOn then
			createESP(plr)
		end
	end)
end)

Players.PlayerRemoving:Connect(function(plr)
	if espObjects[plr] then
		espObjects[plr]:Destroy()
		espObjects[plr] = nil
	end
end)

