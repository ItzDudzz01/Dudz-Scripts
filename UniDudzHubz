		tw(kf, 0.3, {
			BackgroundTransparency = 1,
			Position = UDim2.new(0.5, -140, 0.38, 0)
		})
		tw(kfStroke, 0.3, { Transparency = 1 })
		task.wait(0.32)
		kf:Destroy()

		panel.Visible  = true
		panel.Position = UDim2.new(0.5, -PANEL_W/2, 1.5, 0)
		tw(panel, 0.5, {
			Position = UDim2.new(0.5, -PANEL_W/2, 0.5, -PANEL_H/2)
		}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		task.wait(0.55)
		toast("Welcome lil exploiter!", COLOR_ACCENT)
	else
		task.spawn(shakeFrame, kf)
		local orig = kfStroke.Color
		tw(kfStroke, 0.08, { Color = COLOR_RED })
		task.wait(0.7)
		tw(kfStroke, 0.3, { Color = orig })
		kfBox.Text = ""
	end
end

