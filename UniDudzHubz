local tabList   = {}
local tabData   = {}
local activeTab = nil

local TAB_BTN_H   = 36
local TAB_BTN_GAP = 6
local TAB_BTN_Y0  = 10

local function addTab(name)
	local idx = #tabList + 1
	table.insert(tabList, name)

	local frame = Instance.new("Frame")
	frame.Size                  = UDim2.new(1, 0, 1, 0)
	frame.BackgroundTransparency = 1
	frame.Visible               = false
	frame.Parent                = contentArea

	local yPos = TAB_BTN_Y0 + (idx - 1) * (TAB_BTN_H + TAB_BTN_GAP)

	local btn = Instance.new("TextButton")
	btn.Size             = UDim2.new(1, -16, 0, TAB_BTN_H)
	btn.Position         = UDim2.new(0, 8, 0, yPos)
	btn.BackgroundColor3 = COLOR_BUTTON
	btn.BorderSizePixel  = 0
	btn.Text             = name
	btn.TextColor3       = COLOR_SUB
	btn.Font             = Enum.Font.GothamBold
	btn.TextSize         = 12
	btn.ZIndex           = 3
	btn.Parent           = sidebar
	addCorner(btn, 6)
	hoverBtn(btn)

	local bar = Instance.new("Frame")
	bar.Size                  = UDim2.new(0, 3, 0.6, 0)
	bar.Position              = UDim2.new(0, 0, 0.2, 0)
	bar.BackgroundColor3      = COLOR_ACCENT
	bar.BackgroundTransparency = 1
	bar.BorderSizePixel       = 0
	bar.ZIndex                = 4
	bar.Parent                = btn
	addCorner(bar, 2)

	tabData[name] = { frame = frame, btn = btn, bar = bar }

	btn.Activated:Connect(function()
		if activeTab == name then return end
		activeTab = name
		for _, n in ipairs(tabList) do
			local d  = tabData[n]
			local on = (n == name)
			d.frame.Visible = on
			tw(d.btn, 0.16, {
				BackgroundColor3 = on and COLOR_BUTTON_ACTIVE or COLOR_BUTTON,
				TextColor3       = on and COLOR_TEXT or COLOR_SUB
			})
			tw(d.bar, 0.18, { BackgroundTransparency = on and 0 or 1 })
			d.btn:SetAttribute("Active", on)
		end
	end)

	return frame
end

