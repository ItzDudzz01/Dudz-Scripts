local function tw(obj, t, props, sty, dir)
	TweenService:Create(obj, TweenInfo.new(t,
		sty or Enum.EasingStyle.Quint,
		dir or Enum.EasingDirection.Out
		), props):Play()
end

local function addCorner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 8)
	c.Parent = parent
end

local function addStroke(parent, color, thickness)
	local s = Instance.new("UIStroke")
	s.Color     = color or COLOR_BORDER
	s.Thickness = thickness or 1.5
	s.Parent    = parent
	return s
end

local function hoverBtn(btn)
	btn.MouseEnter:Connect(function()
		if not btn:GetAttribute("Active") then
			tw(btn, 0.1, { BackgroundColor3 = COLOR_BUTTON2 })
		end
	end)
	btn.MouseLeave:Connect(function()
		if not btn:GetAttribute("Active") then
			tw(btn, 0.1, { BackgroundColor3 = COLOR_BUTTON })
		end
	end)
end

local toastBusy = false
local toastQ    = {}

local function toast(msg, color)
	table.insert(toastQ, { msg = msg, col = color or COLOR_TEXT })
	if toastBusy then return end
	toastBusy = true
	task.spawn(function()
		while #toastQ > 0 do
			local item  = table.remove(toastQ, 1)
			local frame = Instance.new("Frame")
			frame.Size             = UDim2.new(0, 210, 0, 34)
			frame.Position         = UDim2.new(1, 220, 1, -12)
			frame.AnchorPoint      = Vector2.new(1, 1)
			frame.BackgroundColor3 = COLOR_BG3
			frame.BorderSizePixel  = 0
			frame.Parent           = screenGui
			addCorner(frame, 6)
			addStroke(frame, item.col, 1)
			local lbl = Instance.new("TextLabel")
			lbl.Size               = UDim2.new(1, -14, 1, 0)
			lbl.Position           = UDim2.new(0, 8, 0, 0)
			lbl.BackgroundTransparency = 1
			lbl.Text               = item.msg
			lbl.TextColor3         = item.col
			lbl.Font               = Enum.Font.Gotham
			lbl.TextSize           = 12
			lbl.TextXAlignment     = Enum.TextXAlignment.Left
			lbl.Parent             = frame
			tw(frame, 0.28, { Position = UDim2.new(1, -12, 1, -12) })
			task.wait(2)
			tw(frame, 0.22, { Position = UDim2.new(1, 220, 1, -12) })
			tw(lbl,   0.22, { TextTransparency = 1 })
			task.wait(0.25)
			frame:Destroy()
			task.wait(0.08)
		end
		toastBusy = false
	end)
end

